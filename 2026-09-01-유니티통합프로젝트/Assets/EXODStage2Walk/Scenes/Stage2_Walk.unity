--- !u!114 &1141109929
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1141109927}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0ca61b9775694b64e91a39d634974786, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  lockedVersion: {fileID: 2068776313}
  openVersion: {fileID: 693722382}
  fitColliderToImage: 0
  boothKey: {fileID: 11400000, guid: a958cc9b6fccb294cbd8ad145a45ff91, type: 2}
  insulatingTape: {fileID: 11400000, guid: 36a9eb9c8c54e444f92c4132a0c62924, type: 2}
  dialButton1: {fileID: 11400000, guid: e9c8e3483272806458129096d64061cc, type: 2}
  dialButton2: {fileID: 11400000, guid: 8766a65dcb6f5e14c8d69b93d2932320, type: 2}
  addressNote: {fileID: 11400000, guid: b3ae3c059c12785429ca73d11f056ae8, type: 2}
  lampsRequired: 4
  interior: {fileID: 944476332}
  standaloneTestKeyFromDay: 0
  lockedLines:
  - speaker: 
    text: "(\uBE68\uAC04 \uC804\uD654 \uBD80\uC2A4\uB2E4. \uBB38\uC774 \uC7A0\uACA8
      \uC788\uB2E4.)"
  lockedHasKeyLines:
  - speaker: 
    text: "(\uBB38\uC774 \uC7A0\uACA8 \uC788\uB2E4. \uD035\uC2AC\uB86F\uC758 \uC5F4\uC1E0\uB97C
      \uBD80\uC2A4\uC5D0 \uB04C\uC5B4\uB2E4 \uB193\uC544 \uBCF4\uC790.)"
  unlockLines:
  - speaker: 
    text: "(\uC5F4\uC1E0\uB97C \uAF42\uACE0 \uB3CC\uB9AC\uC790 \uCCA0\uCEE5, \uBD80\uC2A4
      \uBB38\uC774 \uC5F4\uB838\uB2E4.)"
  addressObtainedLines:
  - speaker: 
    text: "(\uAC00\uB85C\uB4F1 \uBC88\uD638\uD310\uC744 \uBAA8\uB450 \uD655\uC778\uD588\uB2E4.
      \uC9C0\uAE08 \uC788\uB294 \uACF3\uC758 \uC8FC\uC18C\uB97C \uC54C\uC544\uB0C8\uB2E4.)"
  - speaker: 
    text: "[\uC8FC\uC18C\uC9C0]\uB97C \uC5BB\uC5C8\uB2E4."
  addressSlotsFullLines:
  - speaker: 
    text: "(\uC8FC\uC18C\uB294 \uC54C\uC544\uB0C8\uC9C0\uB9CC \uC544\uC774\uD15C
      \uCE78\uC774 \uAF49 \uCC28\uC11C \uC801\uC5B4 \uB458 \uC218\uAC00 \uC5C6\uB2E4.)"
  afterReportReturnLines:
  - speaker: "\uC5EC\uC790\uCE5C\uAD6C"
    text: "\uC624\uB298\uB530\uB77C \uC5BC\uAD74\uC774 \uBC1D\uB124? \uB098\uB791
      \uC0B0\uCC45\uD558\uB294 \uAC8C \uADF8\uB807\uAC8C \uC88B\uC558\uC5B4?"
  - speaker: "\uC5EC\uC790\uCE5C\uAD6C"
    text: "\uB0B4\uC77C\uB3C4 \uAC19\uC774 \uB098\uC624\uC790. \uB0B4\uC77C\uB3C4,
      \uADF8\uB2E4\uC74C \uB0A0\uB3C4\u2026 \uACC4\uC18D."
  callDroppedLines:
  - speaker: 
    text: "(\uB69D\u2014 \uB9D0\uC744 \uB2E4 \uD558\uAE30\uB3C4 \uC804\uC5D0 \uC804\uD654\uAC00
      \uB04A\uACBC\uB2E4. \uB0B4\uC77C \uB2E4\uC2DC \uAC78\uC5B4\uC57C \uD55C\uB2E4.)"
  caughtOnCallLines:
  - speaker: 
    text: "(\uADF8\uB140\uAC00 \uB9D0\uC5C6\uC774 \uC218\uD654\uAE30\uB97C \uBE7C\uC557\uB354\uB2C8,
      \uC120\uC744 \uB2E4\uC2DC \uB72F\uC5B4 \uBC84\uB838\uB2E4.)"
  endingLines:
  - speaker: 
    text: "(\uB529\uB3D9\u2014 \uCD08\uC778\uC885\uC774 \uC6B8\uB838\uB2E4.)"
  - speaker: "\uC5EC\uC790\uCE5C\uAD6C"
    text: "\u2026\uC774 \uC2DC\uAC04\uC5D0 \uB204\uAD6C\uC9C0?"
  - speaker: "\uACBD\uCC30"
    text: "\uACBD\uCC30\uC785\uB2C8\uB2E4! \uC2E0\uACE0 \uBC1B\uACE0 \uCD9C\uB3D9\uD588\uC2B5\uB2C8\uB2E4.
      \uBB38 \uC5F4\uC5B4 \uC8FC\uC138\uC694!"
  - speaker: "\uC5EC\uC790\uCE5C\uAD6C"
    text: "\uACBD\uCC30\u2026? \uC65C \uACBD\uCC30\uC774\u2026"
  - speaker: "\uC5EC\uC790\uCE5C\uAD6C"
    text: "\u2026\uB108\uC57C? \uB124\uAC00 \uBD80\uB978 \uAC70\uC57C?"
  - speaker: 
    text: "(\uBB38\uC774 \uC5F4\uB9AC\uACE0 \uACBD\uCC30\uC774 \uB4E4\uC5B4\uC654\uB2E4.
      \uB4DC\uB514\uC5B4 \uC774 \uC9D1\uC744 \uB098\uAC08 \uC218 \uC788\uB2E4.)"
  endingTitle: "\uD0C8\uCD9C \uC5D4\uB529"
  endingSubtitle: "\uACBD\uCC30\uC5D0 \uC2E0\uACE0\uD574 \uC9D1\uC744 \uBE60\uC838\uB098\uC654\uB2E4."
  endingSceneName: 
