  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 104425228}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a2b8c73382055da4090e59c5bf614fa1, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::EXOD.Walk.WalkGameManager
  player: {fileID: 953468736}
  yandere: {fileID: 1662483086}
  worldCamera: {fileID: 1432310405}
  walkDurationSeconds: 60
  roundTripsRequired: 1
  caughtPenaltySeconds: 60
  lockDoorAfterSuccess: 1
  allowQuitEarly: 1
  anyClickCountsAsInteraction: 1
  fallbackHomeScene: Stage2_Home
  returnDelayAfterSuccess: 1
  returnDelayAfterCaught: 2
  showDebugHud: 1
  firstIntroLines:
  - speaker: "\uC5EC\uC790\uCE5C\uAD6C"
    text: "\uC624\uB298\uBD80\uD130 \uD558\uB8E8\uC5D0 \uD55C \uBC88\uC740 \uB098\uB791
      \uAC19\uC774 \uC0B0\uCC45\uD558\uB294 \uAC70\uC57C."
  - speaker: "\uC5EC\uC790\uCE5C\uAD6C"
    text: "\uC9D1 \uB300\uBB38\uC5D0\uC11C \uC800 \uAE38 \uB05D\uAE4C\uC9C0, \uB450
      \uBC88\uB9CC \uAC14\uB2E4 \uC624\uACE0 \uB4E4\uC5B4\uAC00\uC790."
  - speaker: 
    text: "(\uAE38\uC740 \uC800\uC808\uB85C \uAC77\uB294\uB2E4. \uADF8\uB140\uAC00
      \uB4A4\uB3CC\uC544\uBD24\uC744 \uB54C \uBB34\uC5B8\uAC00\uB97C \uAC74\uB4DC\uB9AC\uBA74
      \uC548 \uB41C\uB2E4.)"
  introLines:
  - speaker: "\uC5EC\uC790\uCE5C\uAD6C"
    text: "\uC624\uB298\uB3C4 \uAC19\uC774 \uAC77\uC790."
  completedLines:
  - speaker: "\uC5EC\uC790\uCE5C\uAD6C"
    text: "\uC624\uB298 \uC0B0\uCC45 \uC990\uAC70\uC6E0\uC5B4. \uC774\uC81C \uB4E4\uC5B4\uAC00\uC790."
  timeUpLines:
  - speaker: "\uC5EC\uC790\uCE5C\uAD6C"
    text: "\uC5B4\uBA38, \uBC8C\uC368 \uC2DC\uAC04\uC774 \uC774\uB807\uAC8C \uB410\uB124.
      \uC774\uC81C \uC9D1\uC5D0 \uAC00\uC790."
  - speaker: 
    text: "\u2026\uB2E4\uC2DC \uADF8 \uC9D1\uC73C\uB85C \uB3CC\uC544\uAC04\uB2E4."
  quitLines:
  - speaker: "\uC5EC\uC790\uCE5C\uAD6C"
    text: "\uBB50\uC57C? \uBC8C\uC368 \uAC00\uAC8C? \u2026\uB098\uB791 \uAC77\uB294
      \uAC8C \uC2EB\uC740 \uAC70\uC57C?"
  - speaker: "\uC5EC\uC790\uCE5C\uAD6C"
    text: "\uB18D\uB2F4\uC774\uC57C~ \uB4E4\uC5B4\uAC00\uC790 \u2661"
  caughtLines:
  - speaker: "\uC5EC\uC790\uCE5C\uAD6C"
    text: "\u2026\uC9C0\uAE08 \uBB50 \uD558\uB294 \uAC70\uC57C?"
  - speaker: "\uC5EC\uC790\uCE5C\uAD6C"
    text: "\uB4E4\uC5B4\uAC00\uC790. \uC624\uB298\uC740 \uC774\uC81C \uBC16\uC5D0
      \uC548 \uB098\uAC08 \uAC70\uC57C."
  dayEndedLines:
  - speaker: "\uC5EC\uC790\uCE5C\uAD6C"
    text: "\uB2A6\uC5C8\uB2E4. \uC774\uB9CC \uB4E4\uC5B4\uAC00\uC790."
  onWalkStarted:
    m_PersistentCalls:
      m_Calls: []
  onWalkSucceeded:
    m_PersistentCalls:
      m_Calls: []
  onCaught:
    m_PersistentCalls:
      m_Calls: []
