    height: 0.55
  phoneArea:
    serializedVersion: 2
    x: 0.06
    y: 0.23
    width: 0.25
    height: 0.66
  callArea:
    serializedVersion: 2
    x: 0.67
    y: 0.33
    width: 0.29
    height: 0.45
  exitArea:
    serializedVersion: 2
    x: 0.74
    y: 0.225
    width: 0.2
    height: 0.075
  boothRed: {r: 0.5, g: 0.03, b: 0.06, a: 1}
  boothDarkRed: {r: 0.26, g: 0.01, b: 0.03, a: 1}
  glassTint: {r: 1, g: 0.08, b: 0.08, a: 0.16}
  canvasSortingOrder: 580
  hideWhileInside:
  - EXOD_PlayerStatusSystem
  - "TeamStatusBarPreview (1\uC2A4\uD14C\uC774\uC9C0 \uC0C1\uB2E8 UI)"
  hideObjectsWhileInside: []
  emergencyNumber: 112
  fireNumber: 119
  reportSeconds: 8
  reportSpeech: "\uC5EC\uAE30\uB294 \uD574\uC6D4\uC2DC \uC11C\uB9BC\uB3D9 \uC740\uD558\uB85C
    3\uAE38 27 \uC55E\uC774\uC5D0\uC694. \uAC00\uB85C\uB4F1 \uAD00\uB9AC\uBC88\uD638\uB294
    0412-B\uC608\uC694. \uC9C0\uAE08 \uC9D1\uC5D0 \uAC07\uD600 \uC788\uC5B4\uC694\u2026
    \uC81C\uBC1C \uC640 \uC8FC\uC138\uC694."
  dialToneClip: {fileID: 0}
  keyBeepClip: {fileID: 0}
  connectClip: {fileID: 0}
  hangUpClip: {fileID: 0}
  firstEnterLines:
  - speaker: 
    text: "(\uBD80\uC2A4 \uC548\uC740 \uC628\uD1B5 \uBE68\uAC1B\uB2E4. \uC720\uB9AC\uCC3D
      \uB108\uBA38\uB85C \uADF8\uB140\uC758 \uB4B7\uBAA8\uC2B5\uC774 \uBCF4\uC778\uB2E4.)"
  - speaker: 
    text: "(\uC804\uD654\uAE30\uB294 \uC218\uD654\uAE30 \uC120\uC774 \uC798\uB824
      \uC788\uACE0, \uB2E4\uC774\uC5BC \uBC84\uD2BC [1]\uACFC [2]\uAC00 \uBE60\uC838
      \uC788\uB2E4.)"
  - speaker: 
    text: "(\uC5EC\uAE30\uC11C\uB3C4 \uADF8\uB140\uAC00 \uB4A4\uB3CC\uC544\uBD24\uC744
      \uB54C \uC6C0\uC9C1\uC774\uBA74 \uB4E4\uD0A8\uB2E4.)"
  enterAfterReportLines:
  - speaker: 
    text: "(\uC2E0\uACE0\uB294 \uB05D\uB0AC\uB2E4. \uC774\uC81C \uACBD\uCC30\uC774
      \uC624\uAE30\uB97C \uAE30\uB2E4\uB9AC\uBA74 \uB41C\uB2E4.)"
  cordCutLines:
  - speaker: 
    text: "(\uC218\uD654\uAE30 \uC120\uC774 \uC798\uB824 \uC788\uB2E4. \uBB34\uC5B8\uAC00\uB85C
      \uC774\uC5B4 \uBD99\uC5EC\uC57C \uD55C\uB2E4.)"
  cordFixedLines:
  - speaker: 
    text: "(\uD14C\uC774\uD504\uB85C \uAC10\uC544 \uB454 \uC120\uC774\uB2E4. \uB2E8\uB2E8\uD788
      \uBD99\uC5B4 \uC788\uB2E4.)"
  tapeUsedLines:
  - speaker: 
    text: "(\uC808\uC5F0 \uD14C\uC774\uD504\uB85C \uC798\uB9B0 \uC120\uC744 \uAF41\uAF41
      \uAC10\uC544 \uC774\uC5C8\uB2E4.)"
  missingButton1Lines:
  - speaker: 
    text: "(\uBC84\uD2BC \uD558\uB098\uAC00 \uBE60\uC838 \uC788\uB2E4. [1] \uC790\uB9AC\uB2E4.)"
  missingButton2Lines:
  - speaker: 
    text: "(\uBC84\uD2BC \uD558\uB098\uAC00 \uBE60\uC838 \uC788\uB2E4. [2] \uC790\uB9AC\uB2E4.)"
  button1UsedLines:
  - speaker: 
    text: "(\uBE48 \uC790\uB9AC\uC5D0 [1] \uBC84\uD2BC\uC744 \uAFB9 \uB07C\uC6E0\uB2E4.)"
  button2UsedLines:
  - speaker: 
    text: "(\uBE48 \uC790\uB9AC\uC5D0 [2] \uBC84\uD2BC\uC744 \uAFB9 \uB07C\uC6E0\uB2E4.)"
  repairedLines:
  - speaker: 
    text: "(\uB69C\u2014\u2026 \uC218\uD654\uAE30\uC5D0\uC11C \uC2E0\uD638\uC74C\uC774
      \uB4E4\uB9B0\uB2E4. \uC774\uC81C \uBC88\uD638\uB97C \uB204\uB97C \uC218 \uC788\uB2E4.)"
  brokenKeyLines:
  - speaker: 
    text: "(\uBC84\uD2BC\uC744 \uB20C\uB7EC \uBD24\uC9C0\uB9CC \uC544\uBB34 \uC18C\uB9AC\uB3C4
      \uB098\uC9C0 \uC54A\uB294\uB2E4. \uC804\uD654\uAC00 \uACE0\uC7A5 \uB098 \uC788\uB2E4.)"
  handsetDeadLines:
  - speaker: 
    text: "(\uC218\uD654\uAE30\uB97C \uADC0\uC5D0 \uB300 \uBD24\uC9C0\uB9CC \uC544\uBB34
      \uC18C\uB9AC\uB3C4 \uB4E4\uB9AC\uC9C0 \uC54A\uB294\uB2E4.)"
  handsetToneLines:
  - speaker: 
    text: "(\uB69C\u2014 \uC2E0\uD638\uC74C\uC774 \uB4E4\uB9B0\uB2E4. \uC5B4\uB514\uC5D0
      \uAC78\uC5B4\uC57C \uD560\uAE4C.)"
  wrongNumberLines:
  - speaker: 
    text: "(\uC5C6\uB294 \uBC88\uD638\uB77C\uB294 \uC548\uB0B4\uAC00 \uD758\uB7EC\uB098\uC654\uB2E4.)"
  connectedLines:
  - speaker: "\uACBD\uCC30"
    text: "\uB124, 112\uC785\uB2C8\uB2E4. \uC9C0\uAE08 \uACC4\uC2E0 \uACF3\uC774
      \uC5B4\uB514\uC785\uB2C8\uAE4C?"
  needAddressLines:
  - speaker: "\uACBD\uCC30"
    text: "\uC5EC\uBCF4\uC138\uC694? \uC9C0\uAE08 \uACC4\uC2E0 \uACF3 \uC8FC\uC18C\uB97C
      \uB9D0\uC500\uD574 \uC8FC\uC138\uC694."
  - speaker: 
    text: "(\uC5EC\uAE30\uAC00 \uC5B4\uB514\uC778\uC9C0 \uC815\uD655\uD788 \uB9D0\uD574\uC57C
      \uD55C\uB2E4. \uD035\uC2AC\uB86F\uC5D0\uC11C [\uC8FC\uC18C\uC9C0]\uB97C \uACE8\uB77C
      \uC218\uD654\uAE30\uB97C \uD074\uB9AD\uD558\uC790.)"
  reportDoneLines:
  - speaker: "\uACBD\uCC30"
    text: "\uD655\uC778\uD588\uC2B5\uB2C8\uB2E4. \uC9C0\uAE08 \uBC14\uB85C \uCD9C\uB3D9\uD558\uACA0\uC2B5\uB2C8\uB2E4."
  - speaker: "\uACBD\uCC30"
    text: "\uB4E4\uD0A4\uC9C0 \uC54A\uAC8C \uD3C9\uC18C\uCC98\uB7FC \uD589\uB3D9\uD558\uC138\uC694.
      \uC804\uD654\uB294 \uB04A\uC73C\uC154\uB3C4 \uB429\uB2C8\uB2E4."
  - speaker: 
    text: "(\uC870\uC6A9\uD788 \uC218\uD654\uAE30\uB97C \uB0B4\uB824\uB193\uC558\uB2E4.)"
  afterReportLines:
  - speaker: 
    text: "(\uD560 \uC77C\uC740 \uB05D\uB0AC\uB2E4. \uC774\uC81C \uD3C9\uC18C\uCC98\uB7FC
      \uB3CC\uC544\uAC00\uC790.)"
  connected119Lines:
  - speaker: 119
    text: "\uB124, 119\uC785\uB2C8\uB2E4. \uBB34\uC2A8 \uC77C\uC774\uC138\uC694?
      \uC9C0\uAE08 \uACC4\uC2E0 \uACF3\uC774 \uC5B4\uB514\uC785\uB2C8\uAE4C?"
  needAddress119Lines:
  - speaker: 119
    text: "\uC5EC\uBCF4\uC138\uC694? \uC8FC\uC18C\uB97C \uB9D0\uC500\uD574 \uC8FC\uC154\uC57C
      \uCD9C\uB3D9\uD560 \uC218 \uC788\uC5B4\uC694."
  - speaker: 
    text: "(\uC5EC\uAE30\uAC00 \uC5B4\uB514\uC778\uC9C0 \uC815\uD655\uD788 \uB9D0\uD574\uC57C
      \uD55C\uB2E4. \uD035\uC2AC\uB86F\uC5D0\uC11C [\uC8FC\uC18C\uC9C0]\uB97C \uACE8\uB77C
      \uC218\uD654\uAE30\uB97C \uD074\uB9AD\uD558\uC790.)"
  reportDone119Lines:
  - speaker: 119
    text: "\uD655\uC778\uD588\uC2B5\uB2C8\uB2E4. \uACBD\uCC30\uC5D0\uB3C4 \uBC14\uB85C
      \uC54C\uB9AC\uACE0 \uD568\uAED8 \uCD9C\uB3D9\uD558\uACA0\uC2B5\uB2C8\uB2E4."
  - speaker: 119
    text: "\uB4E4\uD0A4\uC9C0 \uC54A\uAC8C \uD3C9\uC18C\uCC98\uB7FC \uD589\uB3D9\uD558\uC138\uC694.
      \uC804\uD654\uB294 \uB04A\uC73C\uC154\uB3C4 \uB429\uB2C8\uB2E4."
  - speaker: 
    text: "(\uC870\uC6A9\uD788 \uC218\uD654\uAE30\uB97C \uB0B4\uB824\uB193\uC558\uB2E4.)"
  hangUpLeaveLines:
  - speaker: 
    text: "(\uC218\uD654\uAE30\uB97C \uB0B4\uB824\uB193\uC790 \uC804\uD654\uAC00
      \uB04A\uACBC\uB2E4.)"
